# Normalize all text files to LF in the repo and working tree.
# Prevents CRLF from Windows editors breaking shell scripts and Docker entrypoints.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Lockfiles: treat as generated, keep diffs collapsed in reviews
pnpm-lock.yaml linguist-generated=true -diff
composer.lock linguist-generated=true -diff
