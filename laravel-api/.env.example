APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:81

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Connect DB in Docker
DB_CONNECTION=pgsql
DB_HOST=ml-postgres
DB_PORT=5432
DB_DATABASE=ml_pg_db
DB_USERNAME=ml_pg_user
DB_PASSWORD=ml_pg_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Connect Redis in Docker
REDIS_CLIENT=predis
REDIS_HOST=ml-redis
REDIS_PASSWORD=ml_redis_password
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=backend-user
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

AWS_BUCKET_OFFICIAL=media-official
AWS_BUCKET_TEMP=media-temp
AWS_BUCKET=media-official
AWS_URL=http://localhost:9100
AWS_ENDPOINT=http://ml-minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# WebSocket Server
# WEBSOCKET_PORT=6001
# WEBSOCKET_URL=ws://localhost:6001
# REDIS_CHANNEL_UPLOAD=upload_status

REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=http
# For broadcasting from queue workers (use Docker service name)
# This allows queue workers to connect to Reverb server internally
REVERB_SERVER_HOST="ml-reverb"

BROADCAST_CONNECTION=reverb
