{
  "name": "second-memory-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:fe": "pnpm --filter nextjs-fe dev",
    "dev:docs": "pnpm --filter nextjs-docs dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "pnpm -r --if-present test --run",
    "clean": "pnpm -r exec rm -rf .next node_modules && rm -rf node_modules"
  }
}
