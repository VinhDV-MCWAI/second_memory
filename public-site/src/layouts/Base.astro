---
import '@/styles/global.css';
import { ROUTES } from '@/lib/routes';

interface Props {
  title: string;
  description?: string;
  /** The whole window, for the four columns of the reading page (ADR-0024) */
  full?: boolean;
}

const {
  title,
  description = 'Notes from experience on how software gets built',
  full = false,
} = Astro.props;
const width = full ? 'max-w-none' : 'max-w-4xl';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <header class:list={['mx-auto flex items-center justify-between px-6 pt-6 text-sm', width]}>
      <a href={ROUTES.HOME} class="font-medium hover:underline">
        Second Memory
      </a>
      <span class="flex items-center gap-4">
        {/* The search page has no router (ADR-0024): a full load, not a swap */}
        <form method="get" action={ROUTES.SEARCH} role="search" data-astro-reload>
          <input
            type="search"
            name="q"
            placeholder="Search"
            aria-label="Search articles and categories"
            class="bg-background w-32 rounded-md border px-2 py-1 sm:w-48"
          />
        </form>
        <a href={ROUTES.LOGIN} data-account class="hover:underline">
          Sign in
        </a>
      </span>
    </header>
    <main class:list={['mx-auto px-6', full ? 'py-6' : 'py-12', width]}>
      <slot />
    </main>
    <script>
      import '@/scripts/account-link';
    </script>
  </body>
</html>
