---
import '@/styles/global.css';
import { ROUTES } from '@/lib/routes';

interface Props {
  title: string;
  description?: string;
  /** Room for the side columns of a documentation page (ADR-0022) */
  wide?: boolean;
}

const {
  title,
  description = 'Notes from experience on how software gets built',
  wide = false,
} = Astro.props;
const width = wide ? 'max-w-7xl' : 'max-w-4xl';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class:list={['mx-auto flex items-center justify-between px-6 pt-6 text-sm', width]}>
      <a href={ROUTES.HOME} class="font-medium hover:underline">
        Second Memory
      </a>
      <a href={ROUTES.LOGIN} data-account class="hover:underline">
        Sign in
      </a>
    </header>
    <main class:list={['mx-auto px-6 py-12', width]}>
      <slot />
    </main>
    <script>
      import '@/scripts/account-link';
    </script>
  </body>
</html>
