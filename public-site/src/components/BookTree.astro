---
// The pages of a book, nested like the side menu of a documentation site (ADR-0022); the page
// being read is marked
import type { BookNode } from '@/lib/public-api';
import { ROUTES } from '@/lib/routes';

interface Props {
  nodes: BookNode['children'];
  current: string;
  /** The category of the reading page's column 2, kept by the links (ADR-0024) */
  category?: string;
}

const { nodes, current, category } = Astro.props;
const linkTo = (slug: string) =>
  category ? ROUTES.articleIn(slug, category) : ROUTES.article(slug);
---

<ul class="space-y-1">
  {nodes.map((node) => (
    <li>
      <a
        href={linkTo(node.slug)}
        class:list={[
          'block rounded px-2 py-1',
          node.slug === current ? 'bg-muted font-medium' : 'text-muted-foreground hover:underline',
        ]}
        aria-current={node.slug === current ? 'page' : undefined}
      >
        {node.title}
      </a>
      {node.children.length > 0 && (
        <div class="ml-3 border-l pl-2">
          <Astro.self
            nodes={node.children as BookNode['children']}
            current={current}
            category={category}
          />
        </div>
      )}
    </li>
  ))}
</ul>
