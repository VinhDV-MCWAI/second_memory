---
// ☆ favourite and 🔖 read later for one article, or ☆ for one category (ADR-0020, ADR-0022,
// ADR-0024). The page HTML is the same for every visitor; src/scripts/save-buttons.ts marks what
// the signed-in user saved.
type Props = { label: string } & ({ article: string } | { category: string });

const { label } = Astro.props;
const target =
  'article' in Astro.props
    ? { type: 'article', key: Astro.props.article }
    : { type: 'category', key: Astro.props.category };
const buttons = [
  { kind: 'favorite', icon: '☆', on: '★', title: `Add ${label} to favorites` },
  // Categories are only favourites
  ...(target.type === 'article'
    ? [{ kind: 'read_later', icon: '🔖', on: '🔖', title: `Save ${label} to read later` }]
    : []),
];
---

<span class="inline-flex gap-1 align-middle">
  {buttons.map((button) => (
    <button
      type="button"
      class="text-muted-foreground hover:bg-muted rounded px-1 text-sm aria-pressed:text-primary aria-pressed:bg-muted"
      data-save={button.kind}
      data-type={target.type}
      data-key={target.key}
      data-icon={button.icon}
      data-icon-on={button.on}
      aria-pressed="false"
      title={button.title}
      aria-label={button.title}
    >
      {button.icon}
    </button>
  ))}
</span>
