---
import { MAX_LEVEL } from '@/lib/public-api';

interface Props {
  level: number;
  label: string;
}

// Level as filled dots plus its label, e.g. ●●●○ Independent (3/4).
const { level, label } = Astro.props;
---

<span class="inline-flex items-center gap-2 text-sm">
  <span aria-hidden="true" class="flex gap-1">
    {Array.from({ length: MAX_LEVEL }, (_, index) => (
      <span class:list={['size-2 rounded-full', index < level ? 'bg-primary' : 'bg-border']} />
    ))}
  </span>
  <span>
    {label} ({level}/{MAX_LEVEL})
  </span>
</span>
