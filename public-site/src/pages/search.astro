---
import Marked from '@/components/Marked.astro';
import Base from '@/layouts/Base.astro';
import { searchWords } from '@/lib/highlight';
import { getPublicSearch } from '@/lib/public-api';
import { ROUTES } from '@/lib/routes';
import { QUERY_MAX, QUERY_MIN, isSearchable } from '@/lib/search-query';

/** One row of the result list (REQ-006: one list, each row says what it is) */
interface Hit {
  label: 'Category' | 'Article' | 'Section' | 'Content';
  title: string;
  href: string;
  /** Where it lives: group of a category, article of a section */
  context: string | null;
  /** Plain text marked here */
  text: string | null;
  /** Safe HTML from the API, the words already in <mark> */
  snippet: string | null;
}

const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, QUERY_MAX);
const searchable = isSearchable(q);
const results = searchable ? await getPublicSearch(q) : null;
const words = searchWords(q);

// Categories, then articles found by title, the headings, and last the articles found in their text
const hits: Hit[] = results
  ? [
      ...results.categories.map((category) => ({
        label: 'Category' as const,
        title: category.name,
        href: ROUTES.category(category.slug),
        context: category.group,
        text: null,
        snippet: null,
      })),
      ...results.articles
        .filter((article) => article.found_in === 'title')
        .map((article) => ({
          label: 'Article' as const,
          title: article.title,
          href: ROUTES.article(article.slug),
          context: null,
          text: article.summary,
          snippet: null,
        })),
      ...results.sections.map((section) => ({
        label: 'Section' as const,
        title: section.heading,
        href: ROUTES.articleAt(section.article_slug, section.anchor),
        context: section.article_title,
        text: null,
        snippet: null,
      })),
      ...results.articles
        .filter((article) => article.found_in === 'content')
        .map((article) => ({
          label: 'Content' as const,
          title: article.title,
          href: ROUTES.article(article.slug),
          context: null,
          text: null,
          snippet: article.snippet,
        })),
    ]
  : [];
---

<Base title={q ? `${q} — Search — Second Memory` : 'Search — Second Memory'}>
  <h1 class="text-3xl font-semibold">Search</h1>
  <p class="text-muted-foreground mt-2 text-sm">
    Type in the search box at the top: results come as you type. Accents and case are ignored.
  </p>

  {/* The header's search box swaps this part while typing (header-search.ts) */}
  <div data-search-results>
    {q && !searchable && <p class="mt-8">Type at least {QUERY_MIN} letters or digits.</p>}
    {searchable && hits.length === 0 && <p class="mt-8">Nothing found for “{q}”.</p>}
    {hits.length > 0 && (
      <section class="mt-8" aria-label="Results">
        <p class="text-muted-foreground text-sm">
          {hits.length} {hits.length === 1 ? 'result' : 'results'}
          {results?.match === 'fuzzy' && (
            <span class="text-amber-600"> — no exact match, showing similar results</span>
          )}
        </p>
        <ul class="mt-2 divide-y">
          {hits.map((hit) => (
            <li class="py-3">
              <div class="flex items-baseline gap-2">
                <span class="text-muted-foreground shrink-0 rounded border px-1.5 text-xs">
                  {hit.label}
                </span>
                <a href={hit.href} class="min-w-0 font-medium hover:underline">
                  <Marked text={hit.title} words={words} />
                </a>
                {hit.context && (
                  <span class="text-muted-foreground min-w-0 truncate text-sm">
                    in {hit.context}
                  </span>
                )}
              </div>
              {hit.text && (
                <p class="text-muted-foreground mt-1 text-sm">
                  <Marked text={hit.text} words={words} />
                </p>
              )}
              {hit.snippet && (
                <p class="text-muted-foreground mt-1 text-sm" set:html={hit.snippet} />
              )}
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
