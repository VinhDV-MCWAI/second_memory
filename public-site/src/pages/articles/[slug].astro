---
import RichHtml from '@/components/RichHtml.astro';
import SaveButtons from '@/components/SaveButtons.astro';
import Base from '@/layouts/Base.astro';
import Reader from '@/layouts/Reader.astro';
import { READER_LIST_SIZE } from '@/lib/reader';
import { getPublicArticle, getPublicCategories, getPublicCategory } from '@/lib/public-api';
import { ROUTES } from '@/lib/routes';

const HTTP_NOT_FOUND = 404;

// Private (or under a private article) and missing both answer 404 (ADR-0022)
const article = await getPublicArticle(Astro.params.slug ?? '');
if (!article) {
  Astro.response.status = HTTP_NOT_FOUND;
}
// Column 2 lists the category the reader came from (?in=, kept by its links), else the article's
// first one. Views are counted by the browser once it is really read (ADR-0024), not here.
const wanted = Astro.url.searchParams.get('in');
const shown =
  article?.categories.find(({ slug }) => slug === wanted) ?? article?.categories[0] ?? null;
const [categories, category] = await Promise.all([
  article ? getPublicCategories() : [],
  shown ? getPublicCategory(shown.slug, { per_page: READER_LIST_SIZE }) : null,
]);
// Other articles open with the same column 2
const linkTo = (slug: string) =>
  category ? ROUTES.articleIn(slug, category.slug) : ROUTES.article(slug);
---

{article ? (
  <Reader
    title={`${article.title} — Second Memory`}
    description={article.summary ?? undefined}
    canonical={ROUTES.article(article.slug)}
    categories={categories}
    category={category}
    article={article}
    toc={article.toc}
  >
    <article data-read-article={article.slug} data-article-key={article.key}>
      {/* Group › category › the book's pages above this one › this article */}
      <nav class="text-muted-foreground mt-2 text-sm" aria-label="Breadcrumb">
        <a href={ROUTES.HOME} class="hover:underline">
          Home
        </a>
        {category && (
          <>
            {[...category.ancestors, category].map((up) => (
              <>
                {' › '}
                <a href={ROUTES.category(up.slug)} class="hover:underline">
                  {up.name}
                </a>
              </>
            ))}
          </>
        )}
        {article.ancestors.map((ancestor) => (
          <>
            {' › '}
            <a href={linkTo(ancestor.slug)} class="hover:underline">
              {ancestor.title}
            </a>
          </>
        ))}
        {' › '}
        <span class="text-foreground">{article.title}</span>
      </nav>
      <p class="mt-4 flex flex-wrap gap-2 text-sm">
        {article.categories.map((other) => (
          <a
            href={ROUTES.category(other.slug)}
            class="bg-muted rounded px-2 py-0.5 hover:underline"
          >
            {other.name}
          </a>
        ))}
      </p>
      <h1 class="mt-4 text-3xl font-semibold">
        {article.title} <SaveButtons article={article.key} label={article.title} />
      </h1>
      {article.summary && <p class="text-muted-foreground mt-2">{article.summary}</p>}
      <p class="text-muted-foreground mt-2 font-mono text-xs">
        Updated <time datetime={article.updated_at}>{article.updated_at.slice(0, 10)}</time>
      </p>
      <p data-missing-section hidden class="mt-4 rounded-md border px-3 py-2 text-sm">
        The section you read last time is no longer in this article; starting from the top.
      </p>
      <div data-article-body>
        <RichHtml html={article.body_html} class="mt-8" />
      </div>

      {(article.previous || article.next) && (
        <nav class="mt-12 grid gap-4 border-t pt-6 text-sm sm:grid-cols-2">
          {article.previous ? (
            <a href={linkTo(article.previous.slug)} class="hover:bg-muted rounded-md border p-4">
              <span class="text-muted-foreground block text-xs">← Previous</span>
              <span class="font-medium">{article.previous.title}</span>
            </a>
          ) : (
            <span />
          )}
          {article.next && (
            <a
              href={linkTo(article.next.slug)}
              class="hover:bg-muted rounded-md border p-4 text-right"
            >
              <span class="text-muted-foreground block text-xs">Next →</span>
              <span class="font-medium">{article.next.title}</span>
            </a>
          )}
        </nav>
      )}
    </article>
    <script>
      import '@/scripts/save-buttons';
    </script>
  </Reader>
) : (
  <Base title="Article not found">
    <h1 class="text-3xl font-semibold">Article not found</h1>
    <p class="mt-4">
      <a href={ROUTES.HOME} class="hover:underline">
        ← All categories
      </a>
    </p>
  </Base>
)}
