---
import Base from '@/layouts/Base.astro';
import { getPublicCategories } from '@/lib/public-api';
import { ROUTES } from '@/lib/routes';

// The owner's categories in the order set in the admin app (ADR-0021)
const categories = await getPublicCategories();
const cards = categories.map((category) => ({
  href: ROUTES.category(category.slug),
  name: category.name,
  description: category.description,
  count: category.article_count,
}));
---

<Base title="Second Memory">
  <h1 class="text-3xl font-semibold">Second Memory</h1>
  <p class="text-muted-foreground mt-2">
    Notes from experience on building software. Pick a category.
  </p>

  <ul class="mt-10 grid gap-4 sm:grid-cols-2">
    {cards.map((card) => (
      <li>
        <a href={card.href} class="hover:bg-muted block h-full rounded-lg border p-5">
          <span class="font-medium">{card.name}</span>
          {card.description && <p class="text-muted-foreground mt-1 text-sm">{card.description}</p>}
          <p class="text-muted-foreground mt-3 font-mono text-xs">
            {card.count} {card.count === 1 ? 'article' : 'articles'}
          </p>
        </a>
      </li>
    ))}
  </ul>
</Base>
