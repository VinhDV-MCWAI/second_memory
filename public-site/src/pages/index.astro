---
import Base from '@/layouts/Base.astro';
import { getPublicCategories, type PublicCategory } from '@/lib/public-api';
import { ROUTES } from '@/lib/routes';

// Groups in the owner's order, each with its categories (ADR-0022). The API lists a group right
// before its categories; a category's `group` names it.
const rows = await getPublicCategories();
const groups = rows
  .filter((row) => row.group === null)
  .map((group) => ({ group, categories: rows.filter((row) => row.group === group.name) }));

const count = (category: PublicCategory) =>
  `${category.article_count} ${category.article_count === 1 ? 'article' : 'articles'}`;
---

<Base title="Second Memory">
  <h1 class="text-3xl font-semibold">Second Memory</h1>
  <p class="text-muted-foreground mt-2">
    Notes from experience on building software. Pick a category.
  </p>

  {groups.map(({ group, categories }) => (
    <section class="mt-10">
      <h2 class="text-xl font-semibold">
        <a href={ROUTES.category(group.slug)} class="hover:underline">
          {group.name}
        </a>
      </h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {categories.map((category) => (
          <li>
            <a
              href={ROUTES.category(category.slug)}
              class="hover:bg-muted block h-full rounded-lg border p-5"
            >
              <span class="font-medium">{category.name}</span>
              <p class="text-muted-foreground mt-3 font-mono text-xs">{count(category)}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
