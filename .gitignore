# =======================================================
# Root monorepo .gitignore
# Covers: Laravel (PHP), Next.js (Node/pnpm), Docker, CI/CD
# =======================================================

# -------------------------------------------------------
# Node / pnpm
# -------------------------------------------------------
**/node_modules/
# One lockfile for the whole pnpm workspace (root). No per-package lockfiles.
**/pnpm-lock.yaml
!/pnpm-lock.yaml
**/package-lock.json
**/yarn.lock
**/.pnpm-store/
*.pnpm-debug.log

# -------------------------------------------------------
# PHP / Composer
# -------------------------------------------------------
**/vendor/

# -------------------------------------------------------
# Laravel-specific
# -------------------------------------------------------
laravel-api/.env
laravel-api/storage/*.key
laravel-api/.phpunit.result.cache
laravel-api/storage/framework/cache/data/*
laravel-api/storage/framework/sessions/*
laravel-api/storage/framework/testing/*
laravel-api/storage/framework/views/*
laravel-api/storage/logs/*.log
laravel-api/bootstrap/cache/*.php
laravel-api/public/storage
laravel-api/public/hot
laravel-api/public/build

# -------------------------------------------------------
# Next.js / Nuxt.js
# -------------------------------------------------------
**/.next/
**/out/
**/.nuxt/
**/.output/
nextjs-fe/.env
nextjs-fe/.env.local
nextjs-fe/.env.*.local
nextjs-fe/next-env.d.ts
nextjs-docs/.env
nextjs-docs/next-env.d.ts

# -------------------------------------------------------
# Build / Cache outputs
# -------------------------------------------------------
dist/
build/
.cache/
.parcel-cache/
coverage/
.nyc_output/
*.tsbuildinfo

# -------------------------------------------------------
# Test artifacts
# -------------------------------------------------------
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# -------------------------------------------------------
# Docker
# -------------------------------------------------------
docker/.env

# -------------------------------------------------------
# CI/CD logs
# -------------------------------------------------------
ci-cd/*.log

# -------------------------------------------------------
# Environment files (never commit secrets)
# -------------------------------------------------------
.env
.env.local
.env.*.local

# -------------------------------------------------------
# IDE / Editor
# -------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.iml

# -------------------------------------------------------
# OS artifacts
# -------------------------------------------------------
.DS_Store
Thumbs.db
[Dd]esktop.ini

# -------------------------------------------------------
# Logs
# -------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Simulated stakeholder sealed briefs (local only, revealed at review time)
.claude/sim/sealed/

# k6 summary exports (scripts/perf-baseline.sh); the numbers go into docs/reports/perf/
/perf/results/

# Backup archives (they contain docker/.env) and restore work folder (backup/backup.sh, restore.sh)
/backups/
/restore_tmp/

# Terraform (infra/, ADR-0011): local state holds secrets; provider lock files are committed
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
