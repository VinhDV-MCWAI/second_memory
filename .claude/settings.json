{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(docker ps:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker exec ml-php php artisan test:*)",
      "Bash(docker exec ml-php php artisan route:list:*)",
      "Bash(docker exec ml-php ./vendor/bin/pint:*)",
      "Bash(docker exec ml-php ./vendor/bin/phpstan:*)",
      "Bash(docker exec ml-php ./vendor/bin/rector --dry-run:*)",
      "Bash(docker exec ml-nextjs pnpm lint:*)",
      "Bash(docker exec ml-nextjs pnpm test:*)",
      "Bash(docker exec ml-nextjs pnpm exec tsc:*)",
      "Bash(docker exec ml-nextjs-docs pnpm lint:*)",
      "Bash(docker exec ml-nextjs-docs pnpm exec tsc:*)"
    ],
    "ask": [
      "Bash(docker exec ml-php php artisan migrate:*)",
      "Bash(docker compose down:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*.local)",
      "Read(./docker/postgres/.env)",
      "Read(./docker/redis/.env)",
      "Bash(docker exec ml-php php artisan migrate:fresh:*)",
      "Bash(docker exec ml-php php artisan db:wipe:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "attribution": {
    "commit": ""
  },
  "includeCoAuthoredBy": false
}
